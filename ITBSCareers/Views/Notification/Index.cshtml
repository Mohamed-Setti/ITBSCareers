@model IEnumerable<ITBSCareers.Models.Carriere.Notification>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Notifications";
}

<style>
    .notif-wrap { max-width: 1000px; margin: 0 auto; padding: 1rem 0 2rem; }
    .notif-card {
        background: #fff;
        border: 1px solid #DCDCE1;
        border-radius: 14px;
        padding: 1rem;
        margin-bottom: .8rem;
        box-shadow: 0 8px 20px rgba(24,95,165,.06);
    }
    .notif-type {
        display: inline-block;
        padding: .18rem .52rem;
        border-radius: 999px;
        font-size: .74rem;
        font-weight: 700;
        background: #E6F1FB;
        color: #185FA5;
        margin-bottom: .5rem;
    }
    .notif-type.interview { background: #E1F5EE; color: #0F6E56; }
    .notif-type.warn { background: #FAEEDA; color: #633806; }
</style>

<div class="container notif-wrap">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Notifications</h3>
        <div class="d-flex gap-2 flex-wrap">
            <form asp-action="MarkAllAsRead" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary btn-sm">Tout marquer comme lu</button>
            </form>
            <a asp-controller="User" asp-action="Profile" class="btn btn-outline-secondary btn-sm">Retour profil</a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">@TempData["Message"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">Aucune notification pour le moment.</div>
    }
    else
    {
        foreach (var n in Model)
        {
            var typeClass = n.Type == "InterviewProposal" ? "interview" : n.Type == "InterviewAccepted" || n.Type == "InterviewDeclined" ? "warn" : "";

            <div class="notif-card">
                <div class="notif-type @typeClass">@n.Type</div>
                <div class="mb-2">@n.Content</div>
                <div class="small text-muted mb-2">@n.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</div>

                <div class="d-flex gap-2 flex-wrap">
                    @if (n.Type == "InterviewProposal")
                    {
                        <form asp-action="AcceptInterview" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@n.NotificationId" />
                            <button type="submit" class="btn btn-success btn-sm">Confirmer entretien</button>
                        </form>
                        <form asp-action="DeclineInterview" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@n.NotificationId" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">Refuser entretien</button>
                        </form>
                    }
                    else if (n.IsRead != true)
                    {
                        <form asp-action="MarkAsRead" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@n.NotificationId" />
                            <button type="submit" class="btn btn-outline-primary btn-sm">Marquer lu</button>
                        </form>
                    }
                    else
                    {
                        <span class="badge bg-success">Lu</span>
                    }
                </div>
            </div>
        }
    }
</div>
