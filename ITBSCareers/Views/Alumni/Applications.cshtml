@model IBSTCareers.Models.AlumniApplicationsBoardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Candidatures reçues";
    var currentFilter = (Model.Filter ?? "All").Trim();
    string IsActive(string value) => string.Equals(currentFilter, value, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}

<style>
    :root {
        --teal-dark: #085041;
        --teal: #1D9E75;
        --teal-soft: #E1F5EE;
        --blue: #185FA5;
        --blue-soft: #E6F1FB;
        --amber: #B77900;
        --amber-soft: #FAEEDA;
        --red: #C43A31;
        --red-soft: #FDECEC;
        --gray: #667085;
        --gray-soft: #EEF2F7;
        --bg: #F0F5F3;
        --white: #fff;
        --border: rgba(8,80,65,.12);
        --text: #1E293B;
        --muted: #64756f;
    }

    .apps-shell { max-width: 1240px; margin: 0 auto; padding: 1rem 0 2rem; }
    .hero-card, .stat-card, .panel-card, .app-card, .empty-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(24,95,165,.06);
    }

    .hero-card { padding: 1.1rem 1.2rem; margin-bottom: .9rem; position: relative; overflow: hidden; }
    .hero-card::after {
        content: '';
        position: absolute;
        inset: auto -40px -55px auto;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(29,158,117,.09) 0%, rgba(29,158,117,0) 72%);
        pointer-events: none;
    }

    .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; align-items: center; }
    .hero-title { font-size: 2rem; line-height: 1.05; font-weight: 800; color: var(--text); margin: 0; }
    .hero-sub { color: var(--muted); margin-top: .35rem; }
    .hero-actions { display:flex; gap:.6rem; flex-wrap:wrap; }
    .hero-pill {
        display:inline-flex; align-items:center; gap:.35rem; padding:.28rem .62rem; border-radius:999px;
        font-size:.76rem; font-weight:800; background:rgba(29,158,117,.10); color:var(--teal-dark);
        border:1px solid rgba(29,158,117,.16); margin-right:.35rem;
    }

    .search-row { display:grid; grid-template-columns:minmax(0,1fr) 220px auto; gap:.75rem; margin-bottom:.9rem; }
    .search-card, .filter-card { background:var(--white); border:1px solid var(--border); border-radius:16px; box-shadow:0 8px 18px rgba(24,95,165,.05); }
    .search-card { padding:.9rem 1rem; }
    .filter-card { padding:.8rem; display:flex; gap:.5rem; align-items:center; justify-content:space-between; }

    .form-control, .form-select { border-radius:12px; border-color:rgba(8,80,65,.16); }
    .form-control:focus, .form-select:focus { border-color:var(--teal); box-shadow:0 0 0 .18rem rgba(29,158,117,.12); }

    .filter-link {
        display:inline-flex; align-items:center; gap:.35rem; padding:.45rem .75rem; border-radius:999px;
        border:1px solid rgba(8,80,65,.14); text-decoration:none; color:var(--teal-dark); font-weight:700; background:#fff; white-space:nowrap;
    }
    .filter-link.active { background:var(--teal-dark); color:#fff; border-color:var(--teal-dark); }

    .summary-grid { display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:.75rem; margin-bottom:.9rem; }
    .stat-card { padding:.95rem; }
    .stat-top { display:flex; justify-content:space-between; align-items:flex-start; gap:.6rem; }
    .stat-icon { width:2.6rem; height:2.6rem; border-radius:14px; display:inline-flex; align-items:center; justify-content:center; }
    .tone-teal { background:var(--teal-soft); color:var(--teal-dark); }
    .tone-blue { background:var(--blue-soft); color:var(--blue); }
    .tone-amber { background:var(--amber-soft); color:var(--amber); }
    .tone-red { background:var(--red-soft); color:var(--red); }
    .tone-gray { background:var(--gray-soft); color:var(--gray); }
    .stat-value { font-size:1.9rem; font-weight:900; line-height:1; margin-top:.7rem; }
    .stat-label { color:var(--muted); font-size:.84rem; margin-top:.25rem; }

    .app-card { padding:1rem; display:flex; flex-direction:column; gap:.85rem; margin-bottom:.75rem; }
    .app-head { display:flex; justify-content:space-between; gap:1rem; align-items:flex-start; }
    .app-title { font-size:1.02rem; font-weight:800; color:var(--text); margin:0; }
    .app-sub { color:var(--muted); font-size:.86rem; }
    .badge-status, .badge-pending, .badge-accepted, .badge-rejected {
        display:inline-flex; align-items:center; gap:.3rem; padding:.22rem .55rem; border-radius:999px; font-size:.72rem; font-weight:800; line-height:1;
    }
    .badge-pending { background:rgba(239,159,39,.14); color:#9A6400; }
    .badge-accepted { background:rgba(29,158,117,.12); color:var(--teal-dark); }
    .badge-rejected { background:rgba(196,58,49,.10); color:var(--red); }
    .badge-status { background:rgba(24,95,165,.10); color:var(--blue); }

    .meta-grid { display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:.55rem; }
    .meta-box { border:1px solid rgba(8,80,65,.10); background:linear-gradient(135deg, #fff 0%, #FBFCFB 100%); border-radius:14px; padding:.72rem .8rem; }
    .meta-label { color:var(--muted); font-size:.74rem; text-transform:uppercase; letter-spacing:.04em; }
    .meta-value { font-weight:800; color:var(--text); margin-top:.08rem; }

    .chip-row { display:flex; flex-wrap:wrap; gap:.4rem; }
    .chip { display:inline-flex; align-items:center; padding:.24rem .56rem; border-radius:999px; background:#F4FBF8; color:var(--teal-dark); font-size:.72rem; font-weight:700; }

    .actions-row { display:flex; justify-content:space-between; align-items:center; gap:.75rem; flex-wrap:wrap; }
    .action-btn {
        display:inline-flex; align-items:center; justify-content:center; gap:.45rem; border-radius:14px; border:0; padding:.75rem 1rem;
        font-weight:800; text-decoration:none; min-width:180px;
    }
    .action-btn.primary { background:linear-gradient(135deg, #0F6E56 0%, #115B47 100%); color:#fff; }
    .action-btn.secondary { background:#fff; color:var(--teal-dark); border:1px solid rgba(15,110,86,.18); }
    .action-btn.ghost { background:#EDF2F7; color:#64748B; border:1px solid #E2E8F0; }

    .empty-card { padding:2rem; text-align:center; }
    .empty-illustration { width:88px; height:88px; border-radius:20px; background:linear-gradient(135deg, rgba(29,158,117,.08), rgba(24,95,165,.06)); display:inline-flex; align-items:center; justify-content:center; margin-bottom:1rem; }

    @@media (max-width: 1100px) {
        .hero-grid, .search-row, .summary-grid, .meta-grid { grid-template-columns:1fr; }
        .filter-card { justify-content:flex-start; flex-wrap:wrap; }
    }
</style>

<div class="container apps-shell">
    @if (TempData["JobOfferSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["JobOfferSuccess"]</div>
    }
    @if (TempData["JobOfferError"] != null)
    {
        <div class="alert alert-danger">@TempData["JobOfferError"]</div>
    }

    <div class="hero-card">
        <div class="hero-grid">
            <div>
                <h1 class="hero-title">Candidatures reçues</h1>
                <div class="hero-sub">Consultez toutes les postulations des étudiants, leur statut, leurs détails et l’historique complet.</div>
                <div class="mt-2">
                    <span class="hero-pill">@Model.TotalCount candidatures</span>
                    <span class="hero-pill">@Model.PendingCount en attente</span>
                    <span class="hero-pill">@Model.AcceptedCount acceptées</span>
                </div>
            </div>
            <div class="hero-actions">
                <a asp-controller="Alumni" asp-action="Index" class="action-btn secondary">Retour CVthèque</a>
                <a asp-controller="JobOffer" asp-action="Index" class="action-btn primary">Mes offres</a>
            </div>
        </div>
    </div>

    <form method="get" asp-action="Applications" class="search-row">
        <div class="search-card">
            <label class="form-label fw-bold mb-2" for="query">Recherche</label>
            <input id="query" name="query" value="@Model.Query" class="form-control" placeholder="Étudiant, offre, spécialité, email..." />
        </div>
        <div class="search-card">
            <label class="form-label fw-bold mb-2" for="filter">Statut</label>
            <select id="filter" name="filter" class="form-select">
                <option value="All" selected="@(string.Equals(currentFilter, "All", StringComparison.OrdinalIgnoreCase))">Toutes</option>
                <option value="Pending" selected="@(string.Equals(currentFilter, "Pending", StringComparison.OrdinalIgnoreCase))">En attente</option>
                <option value="Accepted" selected="@(string.Equals(currentFilter, "Accepted", StringComparison.OrdinalIgnoreCase))">Acceptées</option>
                <option value="Rejected" selected="@(string.Equals(currentFilter, "Rejected", StringComparison.OrdinalIgnoreCase))">Refusées</option>
            </select>
        </div>
        <div class="filter-card">
            <button type="submit" class="action-btn primary" style="min-width:auto;">Filtrer</button>
            <a asp-action="Applications" class="filter-link">Réinitialiser</a>
        </div>
    </form>

    <div class="summary-grid">
        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-icon tone-teal">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 7h16v10H4z" stroke="currentColor" stroke-width="1.7"/><path d="M8 7V5h8v2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                </div>
                <span class="badge-status">Total</span>
            </div>
            <div class="stat-value" style="color:var(--teal-dark)">@Model.TotalCount</div>
            <div class="stat-label">Candidatures</div>
        </div>
        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-icon tone-amber">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2v6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M5 11h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                </div>
                <span class="badge-pending">En attente</span>
            </div>
            <div class="stat-value" style="color:var(--amber)">@Model.PendingCount</div>
            <div class="stat-label">À traiter</div>
        </div>
        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-icon tone-teal">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 3l7 4v6c0 5-3.5 7.8-7 9-3.5-1.2-7-4-7-9V7z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <span class="badge-accepted">Acceptées</span>
            </div>
            <div class="stat-value" style="color:var(--teal)">@Model.AcceptedCount</div>
            <div class="stat-label">Éligibles à l’entretien</div>
        </div>
        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-icon tone-blue">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 5h16v14H4z" stroke="currentColor" stroke-width="1.7"/><path d="M8 9h8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                </div>
                <span class="badge-status">Entretiens</span>
            </div>
            <div class="stat-value" style="color:var(--blue)">@Model.InterviewReadyCount</div>
            <div class="stat-label">Propositions possibles</div>
        </div>
    </div>

    <div class="panel-card mb-3">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="section-title mb-0" style="font-weight:800; color:var(--text);">Filtres rapides</div>
            <div class="chip-row">
                <a asp-action="Applications" asp-route-filter="All" asp-route-query="@Model.Query" class="filter-link @IsActive("All")">Toutes</a>
                <a asp-action="Applications" asp-route-filter="Pending" asp-route-query="@Model.Query" class="filter-link @IsActive("Pending")">En attente</a>
                <a asp-action="Applications" asp-route-filter="Accepted" asp-route-query="@Model.Query" class="filter-link @IsActive("Accepted")">Acceptées</a>
                <a asp-action="Applications" asp-route-filter="Rejected" asp-route-query="@Model.Query" class="filter-link @IsActive("Rejected")">Refusées</a>
            </div>
        </div>
    </div>

    @if (!Model.Applications.Any())
    {
        <div class="empty-card">
            <div class="empty-illustration">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none"><path d="M4 7h16v10H4z" stroke="#0F6E56" stroke-width="1.6"/><path d="M8 7V5h8v2" stroke="#0F6E56" stroke-width="1.6" stroke-linecap="round"/></svg>
            </div>
            <h5>Aucune candidature</h5>
            <p class="text-muted mb-3">Aucune postulation ne correspond au filtre sélectionné.</p>
            <a asp-action="Applications" asp-route-filter="All" class="action-btn primary">Voir tout l’historique</a>
        </div>
    }
    else
    {
        @foreach (var app in Model.Applications)
        {
            <div class="app-card">
                <div class="app-head">
                    <div>
                        <h3 class="app-title">@app.StudentName</h3>
                        <div class="app-sub">@app.StudentEmail</div>
                        <div class="app-sub">@app.OfferTitle · @(app.OfferLocation ?? "—") · @(app.OfferType ?? "—")</div>
                    </div>
                    <span class="@(app.Status == "Accepted" ? "badge-accepted" : app.Status == "Rejected" ? "badge-rejected" : "badge-pending")">
                        @(app.Status == "Accepted" ? "Acceptée" : app.Status == "Rejected" ? "Refusée" : "En attente")
                    </span>
                </div>

                <div class="meta-grid">
                    <div class="meta-box">
                        <div class="meta-label">Diplôme</div>
                        <div class="meta-value">@(string.IsNullOrWhiteSpace(app.Degree) ? "—" : app.Degree)</div>
                    </div>
                    <div class="meta-box">
                        <div class="meta-label">Spécialité</div>
                        <div class="meta-value">@(string.IsNullOrWhiteSpace(app.Field) ? "—" : app.Field)</div>
                    </div>
                    <div class="meta-box">
                        <div class="meta-label">Niveau</div>
                        <div class="meta-value">@(string.IsNullOrWhiteSpace(app.Level) ? "—" : app.Level)</div>
                    </div>
                    <div class="meta-box">
                        <div class="meta-label">Postulée le</div>
                        <div class="meta-value">@(app.AppliedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
                    </div>
                </div>

                <div class="chip-row">
                    <span class="chip">@app.SkillsCount compétence(s)</span>
                    <span class="chip">@app.InterestsCount intérêt(s)</span>
                    <span class="chip">@app.ExperiencesCount expérience(s)</span>
                    @if (app.CvUploadedAt != null)
                    {
                        <span class="chip">CV @app.CvUploadedAt?.ToString("dd/MM/yyyy")</span>
                    }
                </div>

                <div class="actions-row">
                    <div class="text-muted small">
                        @if (app.CanProposeInterview)
                        {
                            <span>Cette candidature est acceptée. Vous pouvez proposer un entretien.</span>
                        }
                        else if (app.Status == "Pending")
                        {
                            <span>En attente de décision.</span>
                        }
                        else
                        {
                            <span>Cette candidature a été traitée.</span>
                        }
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        @if (!string.IsNullOrWhiteSpace(app.CvFilePath))
                        {
                            <a href="@app.CvFilePath" target="_blank" rel="noopener" class="action-btn secondary" style="min-width:auto;">Voir CV</a>
                        }

                        @if (app.Status == "Pending")
                        {
                            <form asp-controller="JobOffer" asp-action="AcceptApplication" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="applicationId" value="@app.ApplicationId" />
                                <button type="submit" class="action-btn primary" style="min-width:auto;">Accepter</button>
                            </form>

                            <form asp-controller="JobOffer" asp-action="RejectApplication" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="applicationId" value="@app.ApplicationId" />
                                <button type="submit" class="action-btn ghost" style="min-width:auto;">Refuser</button>
                            </form>
                        }
                        else if (app.CanProposeInterview)
                        {
                            <a asp-controller="JobOffer" asp-action="ProposeInterview" asp-route-applicationId="@app.ApplicationId" class="action-btn primary" style="min-width:auto;">Proposer entretien</a>
                        }
                        else if (app.Status == "Rejected")
                        {
                            <span class="action-btn ghost" style="min-width:auto;">Refusée</span>
                        }
                        else if (app.Status == "Accepted")
                        {
                            <span class="action-btn ghost" style="min-width:auto;">Acceptée</span>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>
