@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Proposer un entretien";
    var application = ViewBag.Application as ITBSCareers.Models.Carriere.Application;
}

<style>
    .interview-wrap { max-width: 780px; margin: 0 auto; padding: 1rem 0 2rem; }
    .interview-card {
        background: #fff;
        border: 1px solid #DCDCE1;
        border-radius: 14px;
        padding: 1.1rem;
        box-shadow: 0 8px 20px rgba(24,95,165,.06);
    }
</style>

<div class="container interview-wrap">
    <div class="interview-card">
        <h3>Proposer un entretien</h3>
        <p class="text-muted">
            @if (application != null)
            {
                <span>Candidature pour <strong>@application.Job.Title</strong> publiée par <strong>@application.Job.Alumni.FullName</strong>.</span>
            }
        </p>

        <form asp-action="RequestInterview" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="applicationId" value="@(application?.ApplicationId)" />

            <div class="mb-3">
                <label class="form-label">Sujet</label>
                <input type="text" name="subject" class="form-control" placeholder="Ex: Entretien téléphonique, rendez-vous campus..." required />
            </div>

            <div class="mb-3">
                <label class="form-label">Message</label>
                <textarea name="message" class="form-control" rows="5" placeholder="Proposez quelques créneaux ou précisez le contexte..." required></textarea>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary">Envoyer la demande</button>
                <a asp-controller="User" asp-action="Profile" class="btn btn-outline-secondary">Retour profil</a>
            </div>
        </form>
    </div>
</div>
