@using IBSTCareers.Models
@using ITBSCareers.Models.Carriere
@using ITBSCareers.Models.Messaging
@model ITBSCareers.Models.Carriere.User
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var roleNames = Model.UserRoles
        .Where(ur => ur.Role != null)
        .Select(ur => ur.Role!.Name)
        .Distinct()
        .ToList();

    var isStudent = roleNames.Contains("Student");
    var isAlumni = roleNames.Contains("Alumni");

    var parts = (Model.FullName ?? "U").Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = string.Concat(parts.Take(2).Select(p => char.ToUpper(p[0])));
    if (string.IsNullOrWhiteSpace(initials)) initials = "U";

    var latestCv = Model.Cvs?.OrderByDescending(c => c.UploadedAt).FirstOrDefault();
    var myApplications = Model.Applications?.OrderByDescending(a => a.AppliedAt).ToList() ?? new List<Application>();

    var studentApplicationsCount = Model.Applications?.Count ?? 0;
    var mentorActif = isStudent ? 1 : 0;
    var profilVu = (Model.UserSkills?.Count ?? 0) * 4 + (Model.UserInterests?.Count ?? 0) * 2 + 10;

    var alumniOffers = Model.JobOffers?.Count ?? 0;
    var alumniReceivedApplications = Model.JobOffers?.SelectMany(o => o.Applications).Count() ?? 0;
    var alumniRating = "4.8";

    var editSkillsUrl = Url.Action("SelectSkillsInterests", "User", new { id = Model.UserId, returnUrl = Url.Action("Profile", "User") });
}

<style>
    :root {
        --bleu: #185FA5;
        --bleu-light: #E6F1FB;
        --bg: #F5F6F8;
        --white: #fff;
        --border: #DCDCE1;
        --teal: #0F6E56;
        --teal-light: #E1F5EE;
        --purple: #3C3489;
        --purple-light: #EEEDFE;
        --amber: #8A5A12;
        --amber-light: #FAEEDA;
        --green: #639922;
        --green-light: #EAF3DE;
        --text-sec: #64646E;
        --dark: #1E1E28;
    }

    .profile-shell {
        display: grid;
        grid-template-columns: 260px minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
    }

    .profile-sidebar,
    .profile-content-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 16px;
        box-shadow: 0 6px 18px rgba(24,95,165,.05);
    }

    .profile-sidebar {
        position: sticky;
        top: 1rem;
        padding: 1rem;
    }

    .avatar {
        width: 76px;
        height: 76px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.45rem;
        margin: 0 auto .75rem;
        background: var(--bleu-light);
        color: var(--bleu);
    }

    .avatar.alumni { background: var(--teal-light); color: var(--teal); }

    .side-name { text-align: center; font-weight: 800; color: var(--dark); }
    .side-sub { text-align: center; color: var(--text-sec); font-size: .86rem; margin-bottom: .8rem; }

    .side-nav {
        display: flex;
        flex-direction: column;
        gap: .35rem;
        margin-top: .75rem;
    }

    .side-link {
        display: block;
        padding: .55rem .75rem;
        border-radius: 10px;
        color: var(--dark);
        text-decoration: none;
        font-weight: 600;
        background: #F8FAFC;
        border: 1px solid transparent;
    }

    .side-link:hover { border-color: var(--bleu-light); background: var(--bleu-light); }

    .side-link.alt { background: #F4FBF8; }
    .side-link.warn { background: #FFF7EA; }

    .profile-content-card { padding: 1rem; }
    .section-title { font-weight: 800; color: var(--dark); margin-bottom: .75rem; }
    .content-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .7rem; margin-bottom: .8rem; }
    .mini-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: .9rem;
        text-align: center;
    }
    .mini-value { font-size: 1.6rem; font-weight: 800; line-height: 1; }
    .mini-label { color: var(--text-sec); font-size: .78rem; }

    .box {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: .9rem;
        margin-bottom: .75rem;
    }

    .pill {
        display: inline-block;
        margin: 0 .35rem .35rem 0;
        padding: .22rem .58rem;
        border-radius: 999px;
        font-size: .76rem;
        font-weight: 700;
    }
    .pill-blue { background: var(--bleu-light); color: var(--bleu); }
    .pill-purple { background: var(--purple-light); color: var(--purple); }
    .pill-amber { background: var(--amber-light); color: var(--amber); }
    .pill-green { background: var(--green-light); color: var(--green); }

    .small-muted { color: var(--text-sec); font-size: .84rem; }
    .cv-upload-zone {
        border: 1.5px dashed rgba(0,0,0,.16);
        border-radius: 10px;
        padding: .8rem;
        text-align: center;
        cursor: pointer;
        margin-bottom: .7rem;
    }
    .cv-upload-zone input[type="file"] { display: none; }
    .cv-submit {
        width: 100%;
        border: 0;
        border-radius: 8px;
        background: var(--bleu);
        color: #fff;
        padding: .45rem .7rem;
        font-size: .85rem;
        font-weight: 600;
    }
    .cv-submit:disabled { background: #b9bcc2; }
    .exp-item { border-top: 1px solid #eee; padding-top: .55rem; margin-top: .55rem; }
    .action-row { display: flex; gap: .5rem; flex-wrap: wrap; }
    .btn-main {
        border: 0;
        border-radius: 8px;
        padding: .45rem .75rem;
        font-size: .84rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
    }
    .btn-main.blue { background: var(--bleu); color: #fff; }
    .btn-main.teal { background: var(--teal); color: #fff; }
    .btn-main.soft { background: #F0F0F2; color: #32323c; border: 1px solid var(--border); }

    @@media (max-width: 992px) {
        .profile-shell { grid-template-columns: 1fr; }
        .profile-sidebar { position: static; }
    }
</style>

<div class="container mt-3 mb-4">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">@TempData["Message"]</div>
    }

    <div class="profile-shell">
        <aside class="profile-sidebar">
            <div class="avatar @(isAlumni ? "alumni" : "")">@initials</div>
            <div class="side-name">@Model.FullName</div>
            <div class="side-sub">@(isAlumni ? (Model.Alumni?.Position ?? "Alumni") : "Étudiant ITBS")</div>

            <div class="side-nav">
                <a href="#overview" class="side-link">Vue générale</a>
                <a href="#skills" class="side-link alt">Compétences</a>
                <a href="#cv" class="side-link">CV</a>
                <a href="#experience" class="side-link alt">Expériences</a>
                <a href="#applications" class="side-link warn">Candidatures</a>
                <a href="#alumni" class="side-link alt">Accès alumni</a>
                <a asp-controller="Notification" asp-action="Index" class="side-link">Notifications</a>
                @if (isStudent)
                {
                    <a asp-controller="JobOffer" asp-action="Feed" class="side-link alt">Offres</a>
                }
                @if (isAlumni)
                {
                    <a asp-controller="JobOffer" asp-action="Index" class="side-link alt">Mes offres</a>
                }
            </div>
        </aside>

        <main class="profile-content-card">
            <section id="overview" class="mb-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                    <div>
                        <h4 class="mb-1" style="font-weight:800;">Profil</h4>
                        <div class="small-muted">
                            @if (isStudent)
                            {
                                <span>Étudiant · membre depuis @Model.CreatedAt?.ToString("MMM yyyy")</span>
                            }
                            else if (isAlumni)
                            {
                                <span>@(Model.Alumni?.CompanyName ?? "ITBS Network") · @(Model.Alumni?.Position ?? "Alumni")</span>
                            }
                        </div>
                    </div>
                    <div class="action-row">
                        <a asp-controller="User" asp-action="SelectSkillsInterests" asp-route-id="@Model.UserId" asp-route-returnUrl="@Url.Action("Profile", "User")" class="btn-main soft">Modifier profil</a>
                    </div>
                </div>

                <div class="content-grid">
                    <div class="mini-card"><div class="mini-value" style="color:var(--bleu)">@((Model.Applications?.Count) ?? 0)</div><div class="mini-label">Candidatures</div></div>
                    <div class="mini-card"><div class="mini-value" style="color:var(--teal)">@((Model.UserSkills?.Count) ?? 0)</div><div class="mini-label">Skills</div></div>
                    <div class="mini-card"><div class="mini-value" style="color:var(--purple)">@((Model.UserInterests?.Count) ?? 0)</div><div class="mini-label">Intérêts</div></div>
                </div>
            </section>

            <section id="skills" class="box">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="section-title mb-0">Compétences & intérêts</div>
                    <a href="@Url.Action("SelectSkillsInterests", "User", new { id = Model.UserId, returnUrl = Url.Action("Profile", "User") })" class="btn-main soft">Modifier</a>
                </div>
                <div class="mt-2">
                    @if (Model.UserSkills.Any())
                    {
                        @foreach (var s in Model.UserSkills)
                        {
                            <span class="pill pill-blue">@s.Skill.Name</span>
                        }
                    }
                    else
                    {
                        <div class="small-muted">Aucune compétence renseignée.</div>
                    }
                </div>
                <div class="mt-2">
                    @if (Model.UserInterests.Any())
                    {
                        @foreach (var i in Model.UserInterests)
                        {
                            <span class="pill pill-purple">@i.Interest.Name</span>
                        }
                    }
                    else
                    {
                        <div class="small-muted">Aucun centre d’intérêt renseigné.</div>
                    }
                </div>
            </section>

            <section id="cv" class="box">
                <div class="section-title">CV</div>
                @if (isStudent)
                {
                    @if (TempData["CvSuccess"] != null)
                    {
                        <div class="alert alert-success py-2">@TempData["CvSuccess"]</div>
                    }
                    @if (TempData["CvError"] != null)
                    {
                        <div class="alert alert-danger py-2">@TempData["CvError"]</div>
                    }

                    <form asp-controller="Cv" asp-action="Upload" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="cv-upload-zone" onclick="document.getElementById('cvFileInput').click()">
                            <div><strong>Choisir un PDF</strong> ou glisser-déposer</div>
                            <div class="small-muted" id="cvFileName">Aucun fichier sélectionné — max 5MB</div>
                            <input type="file" name="cvFile" id="cvFileInput" accept=".pdf" />
                        </div>
                        <button type="submit" id="cvSubmitBtn" class="cv-submit" disabled>Uploader CV</button>
                    </form>

                    @if (latestCv != null)
                    {
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <div><strong>CV courant</strong></div>
                                <div class="small-muted">@latestCv.UploadedAt?.ToString("MMM dd, yyyy HH:mm")</div>
                            </div>
                            <a asp-controller="Cv" asp-action="Open" asp-route-id="@latestCv.Cvid" target="_blank" class="btn-main soft">Voir</a>
                        </div>
                    }
                    else
                    {
                        <div class="small-muted">Aucun CV uploadé pour le moment.</div>
                    }
                }
                else
                {
                    <div class="small-muted">Les CV sont consultés depuis l'espace alumni.</div>
                }
            </section>

            <section id="experience" class="box">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="section-title mb-0">Expériences</div>
                    <a asp-controller="Experience" asp-action="Create" asp-route-userId="@Model.UserId" class="btn-main soft">+ Ajouter</a>
                </div>
                @if (Model.Experiences.Any())
                {
                    @foreach (var exp in Model.Experiences)
                    {
                        <div class="exp-item">
                            <div><strong>@exp.Title</strong> — @exp.Company</div>
                            <div class="small-muted">@exp.StartDate?.ToString("MMM yyyy") - @(exp.EndDate.HasValue ? exp.EndDate.Value.ToString("MMM yyyy") : "Present")</div>
                            @if (!string.IsNullOrWhiteSpace(exp.Description))
                            {
                                <div class="small-muted">@exp.Description</div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="small-muted mt-2">Aucune expérience ajoutée.</div>
                }
            </section>

            <section id="applications" class="box">
                <div class="section-title">Mes candidatures</div>
                @if (myApplications.Any())
                {
                    foreach (var app in myApplications)
                    {
                        <div class="exp-item">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <div><strong>@app.Job?.Title</strong> — @app.Job?.Location</div>
                                    <div class="small-muted">Publié par @(app.Job?.Alumni?.FullName ?? "-") · @app.AppliedAt?.ToString("MMM dd, yyyy HH:mm")</div>
                                </div>
                                <span class="pill @(app.Status == "Accepted" ? "pill-green" : app.Status == "Rejected" ? "pill-amber" : "pill-blue")">@(app.Status ?? "Pending")</span>
                            </div>
                            @if ((app.Status ?? "Pending") == "Accepted")
                            {
                                <div class="small-muted mt-2">Une proposition d'entretien peut être envoyée par l'alumni. Consultez vos notifications.</div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="small-muted">Aucune candidature pour le moment.</div>
                }
            </section>

            <section id="alumni" class="box">
                <div class="section-title">Accès alumni</div>
                @if (isAlumni)
                {
                    <span class="pill pill-green">Statut alumni actif</span>
                    <div class="mt-2"><a asp-controller="Alumni" asp-action="Index" class="btn-main blue">Ouvrir l'espace alumni</a></div>

                    <hr class="my-3" />

                    <div class="section-title mb-2">Visibilité du contact</div>
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <div class="small-muted">Public = les étudiants peuvent vous contacter directement. Privé = ils doivent envoyer une demande.</div>
                            <span class="pill @(Model.Alumni?.IsContactPublic == true ? "pill-green" : "pill-amber") mt-2">@(Model.Alumni?.IsContactPublic == true ? "Public" : "Privé")</span>
                        </div>
                        <form asp-controller="User" asp-action="UpdateContactVisibility" method="post" class="d-flex align-items-center gap-2 flex-wrap">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="isContactPublic" value="@(!(Model.Alumni?.IsContactPublic ?? false))" />
                            <button type="submit" class="btn-main soft">@(Model.Alumni?.IsContactPublic == true ? "Passer en privé" : "Passer en public")</button>
                        </form>
                    </div>

                    @if (Model.Alumni?.IsContactPublic != true)
                    {
                        var requests = ViewBag.PendingContactRequests as List<ContactRequestViewModel> ?? new List<ContactRequestViewModel>();
                        <div class="mt-3">
                            <div class="section-title mb-2">Demandes de contact en attente</div>
                            @if (!requests.Any())
                            {
                                <div class="small-muted">Aucune demande en attente.</div>
                            }
                            else
                            {
                                foreach (var request in requests)
                                {
                                    <div class="exp-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div>
                                            <div><strong>@request.StudentName</strong></div>
                                            <div class="small-muted">Demande reçue le @request.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                        </div>
                                        <div class="action-row mt-0">
                                            <form asp-controller="Messaging" asp-action="AcceptContactRequest" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="requestId" value="@request.RequestId" />
                                                <button type="submit" class="btn-main blue">Accepter</button>
                                            </form>
                                            <form asp-controller="Messaging" asp-action="RejectContactRequest" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="requestId" value="@request.RequestId" />
                                                <button type="submit" class="btn-main soft">Refuser</button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                }
                else if (isStudent)
                {
                    <div class="small-muted mb-2">Demandez le statut alumni. Validation admin obligatoire.</div>
                    <div class="action-row">
                        <a asp-controller="AlumniRequest" asp-action="Create" class="btn-main teal">Demander statut alumni</a>
                        <a asp-controller="AlumniRequest" asp-action="MyRequests" class="btn-main soft">Mes demandes alumni</a>
                    </div>
                }
            </section>

            @if (ViewBag.AlumniRequests is List<AlumniRequestListItemViewModel> alumniRequests)
            {
                <section class="box">
                    <div class="section-title">Historique des demandes alumni</div>
                    @if (!alumniRequests.Any())
                    {
                        <div class="small-muted">Aucune demande enregistrée.</div>
                    }
                    else
                    {
                        foreach (var request in alumniRequests)
                        {
                            <div class="exp-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <div><strong>@request.CompanyName</strong> — @request.Position</div>
                                    <div class="small-muted">Soumise le @request.CreatedAt?.ToString("dd/MM/yyyy HH:mm") · Révisée le @(request.ReviewedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
                                </div>
                                <span class="pill @(request.Status == "Approved" ? "pill-green" : request.Status == "Rejected" ? "pill-amber" : "pill-blue")">@request.Status</span>
                            </div>
                        }
                    }
                </section>
            }
        </main>
    </div>
</div>

<script>
    const input = document.getElementById('cvFileInput');
    const label = document.getElementById('cvFileName');
    const btn = document.getElementById('cvSubmitBtn');

    if (input && label && btn) {
        input.addEventListener('change', function () {
            if (this.files && this.files[0]) {
                label.textContent = this.files[0].name;
                btn.disabled = false;
            } else {
                label.textContent = 'Aucun fichier sélectionné — max 5MB';
                btn.disabled = true;
            }
        });
    }
</script>
