@using ITBSCareers.Models.Carriere
@model ITBSCareers.Models.Carriere.User
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var roleNames = Model.UserRoles
        .Where(ur => ur.Role != null)
        .Select(ur => ur.Role!.Name)
        .Distinct()
        .ToList();

    var isStudent = roleNames.Contains("Student");
    var isAlumni = roleNames.Contains("Alumni");

    var parts = (Model.FullName ?? "U").Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = string.Concat(parts.Take(2).Select(p => char.ToUpper(p[0])));
    if (string.IsNullOrWhiteSpace(initials)) initials = "U";

    var latestCv = Model.Cvs?.OrderByDescending(c => c.UploadedAt).FirstOrDefault();
    var myApplications = Model.Applications?.OrderByDescending(a => a.AppliedAt).ToList() ?? new List<Application>();

    var studentApplicationsCount = Model.Applications?.Count ?? 0;
    var mentorActif = isStudent ? 1 : 0;
    var profilVu = (Model.UserSkills?.Count ?? 0) * 4 + (Model.UserInterests?.Count ?? 0) * 2 + 10;

    var alumniOffers = Model.JobOffers?.Count ?? 0;
    var alumniReceivedApplications = Model.JobOffers?.SelectMany(o => o.Applications).Count() ?? 0;
    var alumniRating = "4.8";

    var editSkillsUrl = Url.Action("SelectSkillsInterests", "User", new { id = Model.UserId, returnUrl = Url.Action("Profile", "User") });
}

<style>
    :root {
        --bleu: #185FA5;
        --bleu-light: #E6F1FB;
        --bg: #F5F6F8;
        --white: #fff;
        --border: #DCDCE1;
        --teal: #0F6E56;
        --teal-light: #E1F5EE;
        --purple: #3C3489;
        --purple-light: #EEEDFE;
        --amber: #633806;
        --amber-light: #FAEEDA;
        --green: #639922;
        --green-light: #EAF3DE;
        --text-sec: #64646E;
        --dark: #1E1E28;
    }

    .profile-page {
        background: var(--bg);
        border-radius: 14px;
        overflow: hidden;
        margin-bottom: 1.2rem;
    }

    .profile-cover {
        height: 110px;
        background: var(--bleu-light);
    }

    .profile-cover.alumni { background: var(--teal-light); }

    .profile-main {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        padding: 0 1.2rem 1rem;
        text-align: center;
        position: relative;
    }

    .avatar {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        margin: -42px auto 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.6rem;
        border: 4px solid #fff;
        background: var(--bleu-light);
        color: var(--bleu);
    }

    .avatar.alumni {
        background: var(--teal-light);
        color: var(--teal);
    }

    .profile-name {
        font-size: 1.45rem;
        font-weight: 700;
        color: var(--dark);
        margin-bottom: .2rem;
    }

    .profile-sub {
        color: var(--text-sec);
        font-size: .93rem;
        margin-bottom: .18rem;
    }

    .verified-badge {
        display: inline-block;
        background: var(--teal-light);
        color: var(--teal);
        font-size: .76rem;
        font-weight: 700;
        border-radius: 999px;
        padding: .22rem .62rem;
        margin-left: .45rem;
    }

    .section-wrap { padding: 1rem 1.2rem 1.2rem; }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .6rem;
        margin-bottom: .8rem;
    }

    .stat-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 12px;
        min-height: 88px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .stat-value { font-size: 1.8rem; font-weight: 700; line-height: 1; }
    .stat-label { color: var(--text-sec); font-size: .76rem; margin-top: .2rem; }

    .box {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: .9rem;
        margin-bottom: .7rem;
    }

    .box-title {
        font-size: .95rem;
        font-weight: 700;
        color: var(--dark);
        margin-bottom: .65rem;
    }

    .pill {
        display: inline-block;
        margin: 0 .35rem .35rem 0;
        padding: .25rem .6rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 700;
    }

    .pill-blue { background: var(--bleu-light); color: var(--bleu); }
    .pill-purple { background: var(--purple-light); color: var(--purple); }
    .pill-amber { background: var(--amber-light); color: var(--amber); }
    .pill-green { background: var(--green-light); color: var(--green); }

    .cv-upload-zone {
        border: 1.5px dashed rgba(0,0,0,.16);
        border-radius: 10px;
        padding: .8rem;
        text-align: center;
        cursor: pointer;
        margin-bottom: .7rem;
    }

    .cv-upload-zone input[type="file"] { display: none; }

    .cv-submit {
        width: 100%;
        border: 0;
        border-radius: 8px;
        background: var(--bleu);
        color: #fff;
        padding: .45rem .7rem;
        font-size: .85rem;
        font-weight: 600;
    }

    .cv-submit:disabled { background: #b9bcc2; }

    .cv-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-top: 1px solid #eee;
        padding-top: .55rem;
        margin-top: .55rem;
        gap: .55rem;
    }

    .action-row { display: flex; gap: .5rem; flex-wrap: wrap; }

    .btn-main {
        border: 0;
        border-radius: 8px;
        padding: .45rem .75rem;
        font-size: .84rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
    }

    .btn-main.blue { background: var(--bleu); color: #fff; }
    .btn-main.teal { background: var(--teal); color: #fff; }
    .btn-main.soft { background: #F0F0F2; color: #32323c; border: 1px solid var(--border); }

    .exp-item { border-top: 1px solid #eee; padding-top: .55rem; margin-top: .55rem; }

    .small-muted { color: var(--text-sec); font-size: .82rem; }

    @@media (max-width: 900px) {
        .stats-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="container mt-3">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">@TempData["Message"]</div>
    }

    <div class="profile-page">
        <div class="profile-cover @(isAlumni ? "alumni" : "")"></div>

        <div class="profile-main">
            <div class="avatar @(isAlumni ? "alumni" : "")">@initials</div>
            <div class="profile-name">
                @Model.FullName
                @if (isAlumni)
                {
                    <span class="verified-badge">✓ Vérifiée</span>
                }
            </div>

            @if (isStudent)
            {
                <div class="profile-sub">Étudiant · ITBS</div>
                <div class="profile-sub">Membre depuis @Model.CreatedAt?.ToString("MMM yyyy")</div>
            }
            else if (isAlumni)
            {
                <div class="profile-sub">@(Model.Alumni?.Position ?? "Alumni") · @(Model.Alumni?.CompanyName ?? "ITBS Network")</div>
                <div class="profile-sub">Promo ITBS</div>
            }
            else
            {
                <div class="profile-sub">Utilisateur ITBS Careers</div>
            }
        </div>

        <div class="action-row">
            <a asp-controller="Notification" asp-action="Index" class="btn-main soft">Notifications</a>
            @if (isStudent)
            {
                <a asp-controller="JobOffer" asp-action="Feed" class="btn-main teal">Voir les offres</a>
            }
            @if (isAlumni)
            {
                <a asp-controller="JobOffer" asp-action="Index" class="btn-main blue">Mes offres</a>
            }
        </div>

        <div class="section-wrap">
            @if (isAlumni)
            {
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-value" style="color:var(--teal)">@alumniOffers</div>
                        <div class="stat-label">Offres actives</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value" style="color:var(--bleu)">@alumniReceivedApplications</div>
                        <div class="stat-label">Mentorés / candidatures</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value" style="color:var(--amber)">@alumniRating</div>
                        <div class="stat-label">Note moyenne</div>
                    </div>
                </div>

                <div class="box">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="box-title mb-0">Expertises</div>
                        <a href="@editSkillsUrl" class="btn-main soft">Modifier</a>
                    </div>
                    @if (Model.UserSkills.Any())
                    {
                        @foreach (var s in Model.UserSkills)
                        {
                            <span class="pill pill-green">@s.Skill.Name</span>
                        }
                    }
                    else
                    {
                        <span class="small-muted">Aucune expertise renseignée.</span>
                    }
                </div>

                <div class="box">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="box-title mb-0">Thématiques de mentorat proposées</div>
                        <a href="@editSkillsUrl" class="btn-main soft">Modifier</a>
                    </div>
                    @if (Model.UserInterests.Any())
                    {
                        @foreach (var i in Model.UserInterests)
                        {
                            <span class="pill pill-amber">@i.Interest.Name</span>
                        }
                    }
                    else
                    {
                        <span class="small-muted">Aucune thématique renseignée.</span>
                    }
                </div>

                <div class="box">
                    <div class="box-title">Disponibilité</div>
                    <span class="pill pill-green">Disponible au mentorat</span>
                    <div class="small-muted mt-2">Répond généralement sous 48h.</div>
                </div>

                <div class="box">
                    <div class="box-title">Actions</div>
                    <div class="action-row">
                        <a class="btn-main soft" href="#">Envoyer un message</a>
                        <a class="btn-main teal" href="#">Demander un mentorat</a>
                        <a class="btn-main blue" asp-controller="Alumni" asp-action="Index">Espace alumni</a>
                    </div>
                </div>
            }
            else
            {
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-value" style="color:var(--bleu)">@studentApplicationsCount</div>
                        <div class="stat-label">Candidatures</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value" style="color:var(--teal)">@mentorActif</div>
                        <div class="stat-label">Mentor actif</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value" style="color:var(--purple)">@profilVu</div>
                        <div class="stat-label">Profil vu</div>
                    </div>
                </div>

                <div class="box">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="box-title mb-0">Compétences techniques</div>
                        <a href="@editSkillsUrl" class="btn-main soft">Modifier</a>
                    </div>
                    @if (Model.UserSkills.Any())
                    {
                        @foreach (var s in Model.UserSkills)
                        {
                            <span class="pill pill-blue">@s.Skill.Name</span>
                        }
                    }
                    else
                    {
                        <span class="small-muted">Aucune compétence renseignée.</span>
                    }
                </div>

                <div class="box">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="box-title mb-0">Centres d'intérêt</div>
                        <a href="@editSkillsUrl" class="btn-main soft">Modifier</a>
                    </div>
                    @if (Model.UserInterests.Any())
                    {
                        @foreach (var i in Model.UserInterests)
                        {
                            <span class="pill pill-purple">@i.Interest.Name</span>
                        }
                    }
                    else
                    {
                        <span class="small-muted">Aucun centre d'intérêt renseigné.</span>
                    }
                </div>

                <div class="box">
                    <div class="box-title">CV & visibilité</div>

                    @if (TempData["CvSuccess"] != null)
                    {
                        <div class="alert alert-success py-2">@TempData["CvSuccess"]</div>
                    }
                    @if (TempData["CvError"] != null)
                    {
                        <div class="alert alert-danger py-2">@TempData["CvError"]</div>
                    }

                    <form asp-controller="Cv" asp-action="Upload" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="cv-upload-zone" onclick="document.getElementById('cvFileInput').click()">
                            <div><strong>Choisir un PDF</strong> ou glisser-déposer</div>
                            <div class="small-muted" id="cvFileName">Aucun fichier sélectionné — max 5MB</div>
                            <input type="file" name="cvFile" id="cvFileInput" accept=".pdf" />
                        </div>
                        <button type="submit" id="cvSubmitBtn" class="cv-submit" disabled>Uploader CV</button>
                    </form>

                    @if (latestCv != null)
                    {
                        <div class="cv-row">
                            <div>
                                <div><strong>CV courant</strong></div>
                                <div class="small-muted">@latestCv.UploadedAt?.ToString("MMM dd, yyyy HH:mm")</div>
                            </div>
                            <div class="action-row">
                                <a asp-controller="Cv" asp-action="Open" asp-route-id="@latestCv.Cvid" target="_blank" class="btn-main soft">Voir</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="small-muted mt-2">Aucun CV uploadé pour le moment.</div>
                    }
                </div>
            }

            <div class="box">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="box-title mb-0">Expériences</div>
                    <a asp-controller="Experience" asp-action="Create" asp-route-userId="@Model.UserId" class="btn-main soft">+ Ajouter</a>
                </div>

                @if (Model.Experiences.Any())
                {
                    @foreach (var exp in Model.Experiences)
                    {
                        <div class="exp-item">
                            <div><strong>@exp.Title</strong> — @exp.Company</div>
                            <div class="small-muted">
                                @exp.StartDate?.ToString("MMM yyyy") - @(exp.EndDate.HasValue ? exp.EndDate.Value.ToString("MMM yyyy") : "Present")
                            </div>
                            @if (!string.IsNullOrWhiteSpace(exp.Description))
                            {
                                <div class="small-muted">@exp.Description</div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="small-muted mt-2">Aucune expérience ajoutée.</div>
                }
            </div>

            <div class="box">
                <div class="box-title">Accès Alumni</div>
                @if (isAlumni)
                {
                    <span class="pill pill-green">Statut alumni actif</span>
                    <div class="mt-2"><a asp-controller="Alumni" asp-action="Index" class="btn-main blue">Ouvrir l'espace alumni</a></div>
                }
                else if (isStudent)
                {
                    <div class="small-muted mb-2">Demandez le statut alumni. Validation admin obligatoire.</div>
                    <a asp-controller="AlumniRequest" asp-action="Create" class="btn-main teal">Demander statut alumni</a>
                }
                else
                {
                    <div class="small-muted">Seuls les étudiants peuvent faire une demande alumni.</div>
                }
            </div>

            <div class="box">
                <div class="box-title">Mes candidatures</div>
                @if (myApplications.Any())
                {
                    foreach (var app in myApplications)
                    {
                        <div class="exp-item">
                            <div><strong>@app.Job?.Title</strong> — @app.Job?.Location</div>
                            <div class="small-muted">Type: @(app.Job?.Type ?? "-") · Publié par @(app.Job?.Alumni?.FullName ?? "-")</div>
                            <div class="small-muted">Postulé le @app.AppliedAt?.ToString("MMM dd, yyyy HH:mm") · Statut: <strong>@(app.Status ?? "Pending")</strong></div>
                            <div class="action-row mt-2">
                                @if ((app.Status ?? "Pending") == "Accepted")
                                {
                                    <a asp-controller="User" asp-action="RequestInterview" asp-route-applicationId="@app.ApplicationId" class="btn-main teal">Proposer entretien</a>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="small-muted">Aucune candidature pour le moment.</div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    const input = document.getElementById('cvFileInput');
    const label = document.getElementById('cvFileName');
    const btn = document.getElementById('cvSubmitBtn');

    if (input && label && btn) {
        input.addEventListener('change', function () {
            if (this.files && this.files[0]) {
                label.textContent = this.files[0].name;
                btn.disabled = false;
            } else {
                label.textContent = 'Aucun fichier sélectionné — max 5MB';
                btn.disabled = true;
            }
        });

        const zone = document.querySelector('.cv-upload-zone');
        if (zone) {
            zone.addEventListener('dragover', e => { e.preventDefault(); zone.style.background = '#f0f7ff'; });
            zone.addEventListener('dragleave', () => { zone.style.background = ''; });
            zone.addEventListener('drop', e => {
                e.preventDefault();
                zone.style.background = '';
                const files = e.dataTransfer.files;
                if (files.length) {
                    const dt = new DataTransfer();
                    dt.items.add(files[0]);
                    input.files = dt.files;
                    label.textContent = files[0].name;
                    btn.disabled = false;
                }
            });
        }
    }
</script>
