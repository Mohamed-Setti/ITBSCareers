@model ITBSCareers.Models.Carriere.User
@{
    ViewData["Title"] = "Inscription";
}

<style>
    .auth-wrap {
        min-height: 76vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .auth-card {
        width: 100%;
        max-width: 520px;
        background: #fff;
        border: 1px solid #DCDCE1;
        border-radius: 14px;
        padding: 1.6rem;
        box-shadow: 0 8px 20px rgba(24, 95, 165, 0.08);
        position: relative;
    }

    .auth-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        border-radius: 14px 14px 0 0;
        background: linear-gradient(90deg, #185FA5, #0F6E56);
    }

    .auth-title {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 2rem;
        color: #1E1E28;
        letter-spacing: 1px;
        margin-bottom: .15rem;
    }

    .auth-sub {
        color: #64646E;
        font-size: .9rem;
        margin-bottom: 1.2rem;
    }

    .auth-label {
        font-size: .78rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #64646E;
        margin-bottom: .35rem;
    }

    .auth-input {
        border: 1px solid #DCDCE1;
        border-radius: 10px;
        padding: .65rem .75rem;
        font-size: .95rem;
    }

    .auth-input:focus {
        border-color: #185FA5;
        box-shadow: 0 0 0 .15rem rgba(24, 95, 165, 0.12);
    }

    .btn-auth {
        width: 100%;
        border: 0;
        border-radius: 10px;
        padding: .72rem;
        background: linear-gradient(135deg, #185FA5, #0F6E56);
        color: #fff;
        font-weight: 700;
    }

    .auth-note {
        margin-top: .9rem;
        background: #E6F1FB;
        color: #185FA5;
        border-radius: 10px;
        padding: .6rem .7rem;
        font-size: .82rem;
    }

    .auth-link {
        color: #185FA5;
        text-decoration: none;
        font-weight: 600;
    }

    span.text-danger { font-size: .8rem; }
</style>

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-title">Créer un compte</div>
        <div class="auth-sub">Rejoignez la plateforme carrière de l'ITBS.</div>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="auth-label"></label>
                <input asp-for="FullName" class="form-control auth-input" placeholder="Nom complet" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="auth-label"></label>
                <input asp-for="Email" class="form-control auth-input" placeholder="exemple@itbs.tn" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PasswordHash" class="auth-label">Password</label>
                <input asp-for="PasswordHash" type="password" class="form-control auth-input" placeholder="••••••••" />
                <span asp-validation-for="PasswordHash" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-auth">Créer mon compte</button>

            <div class="auth-note">
                Les nouveaux comptes sont créés avec le rôle <strong>Student</strong> par défaut.
            </div>
        </form>

        <div class="text-center mt-3">
            <span class="text-muted">Déjà inscrit ? </span>
            <a asp-controller="User" asp-action="Login" class="auth-link">Se connecter</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}