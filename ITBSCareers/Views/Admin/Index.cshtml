@model IEnumerable<ITBSCareers.Models.Carriere.AlumniRequest>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard Admin";
}

<style>
    .admin-head { background:#fff; border:1px solid #DCDCE1; border-radius:14px; padding:1rem; box-shadow:0 6px 18px rgba(24,95,165,.05); }
</style>

<div class="container mt-4">
    <div class="admin-head mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 class="mb-1">Dashboard Admin</h2>
            <div class="text-muted">Validez les demandes alumni et gérez les utilisateurs.</div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Users" class="btn btn-primary btn-sm">Gérer les utilisateurs</a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-sm">Dashboard</a>
        </div>
    </div>

    @if (ViewBag.Warning != null)
    {
        <div class="alert alert-warning">@ViewBag.Warning</div>
    }

    <div class="card shadow-sm p-3 mb-3">
        <h5 class="mb-1">Demandes en attente</h5>
        <p class="text-muted mb-0">Total: <strong>@Model.Count()</strong></p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Aucune demande en attente.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>Company</th>
                        <th>Position</th>
                        <th>Proof</th>
                        <th>Créée le</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>@request.UserId</td>
                        <td>@request.CompanyName</td>
                        <td>@request.Position</td>
                        <td>@request.ProofFilePath</td>
                        <td>@request.CreatedAt</td>
                        <td>
                        <a asp-controller="AlumniRequest" asp-action="Manage" class="btn btn-sm btn-outline-primary">Ouvrir la gestion</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
