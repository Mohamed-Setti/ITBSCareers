@model IEnumerable<ITBSCareers.Models.Carriere.JobOffer>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Mes offres";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Mes offres publiées</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Nouvelle offre</a>
    </div>

    @if (TempData["JobOfferSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["JobOfferSuccess"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">Aucune offre publiée pour le moment.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@item.Title</h5>
                            <div class="mb-2 text-muted">@item.Location · @item.Type</div>
                            <p class="card-text">@item.Description</p>
                            <small class="text-muted d-block mb-3">Publié le @item.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</small>

                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-controller="JobOffer" asp-action="Details" asp-route-id="@item.JobId" class="btn btn-sm btn-outline-primary">Voir</a>
                                <a asp-controller="JobOffer" asp-action="Applications" asp-route-id="@item.JobId" class="btn btn-sm btn-warning">Candidatures</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-3">
        <a asp-controller="Alumni" asp-action="Index" class="btn btn-outline-secondary btn-sm">Retour espace alumni</a>
    </div>
</div>
