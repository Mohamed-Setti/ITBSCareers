@model IEnumerable<ITBSCareers.Models.Carriere.Application>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Candidatures";
    var offerTitle = ViewBag.OfferTitle as string ?? "Offre";
    var offerId = ViewBag.OfferId;
}

<style>
    .apps-wrap { max-width: 1180px; margin: 0 auto; padding: 1rem 0 2rem; }
    .app-card {
        background: #fff;
        border: 1px solid #DCDCE1;
        border-radius: 14px;
        padding: 1rem;
        margin-bottom: .8rem;
        box-shadow: 0 8px 20px rgba(24,95,165,.06);
    }
    .pill {
        display: inline-block;
        margin: 0 .35rem .35rem 0;
        padding: .2rem .55rem;
        border-radius: 999px;
        font-size: .76rem;
        font-weight: 700;
        background: #E6F1FB;
        color: #185FA5;
    }
    .pill-green { background: #E1F5EE; color: #0F6E56; }
    .pill-red { background: #FCEBEB; color: #A32D2D; }
    .small-muted { color: #64646E; font-size: .82rem; }
</style>

<div class="container apps-wrap">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">Candidatures</h3>
            <div class="small-muted">Offre: <strong>@offerTitle</strong></div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Mes offres</a>
    </div>

    @if (TempData["JobOfferSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["JobOfferSuccess"]</div>
    }
    @if (TempData["JobOfferError"] != null)
    {
        <div class="alert alert-danger">@TempData["JobOfferError"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">Aucune candidature pour cette offre.</div>
    }
    else
    {
        foreach (var app in Model)
        {
            <div class="app-card">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <h5 class="mb-1">@app.Student.FullName</h5>
                        <div class="small-muted">@app.Student.Email</div>
                        <div class="small-muted">
                            @((app.Student.Student?.Degree?.Name) ?? "-") ·
                            @((app.Student.Student?.Field) ?? "-") ·
                            @((app.Student.Student?.Level) ?? "-")
                        </div>
                        <div class="small-muted">Postulé le @app.AppliedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="small-muted">Statut: <strong>@(app.Status ?? "Pending")</strong></div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        @if (app.Cv != null)
                        {
                            <a asp-controller="Cv" asp-action="Open" asp-route-id="@app.Cv.Cvid" target="_blank" class="btn btn-sm btn-outline-primary">Voir CV</a>
                        }

                        @if (string.IsNullOrWhiteSpace(app.Status) || app.Status == "Pending")
                        {
                            <form asp-action="AcceptApplication" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="applicationId" value="@app.ApplicationId" />
                                <button type="submit" class="btn btn-sm btn-success">Accepter</button>
                            </form>

                            <form asp-action="RejectApplication" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="applicationId" value="@app.ApplicationId" />
                                <button type="submit" class="btn btn-sm btn-danger">Refuser</button>
                            </form>
                        }
                        else if (app.Status == "Accepted")
                        {
                            <span class="btn btn-sm btn-success disabled">Acceptée</span>
                            <a asp-action="ProposeInterview" asp-route-applicationId="@app.ApplicationId" class="btn btn-sm btn-primary">Proposer entretien</a>
                        }
                        else if (app.Status == "Rejected")
                        {
                            <span class="btn btn-sm btn-danger disabled">Refusée</span>
                        }
                    </div>
                </div>

                <div class="mt-2">
                    @if (app.Student.UserSkills.Any())
                    {
                        foreach (var s in app.Student.UserSkills)
                        {
                            <span class="pill">@s.Skill.Name</span>
                        }
                    }
                    @if (app.Student.UserInterests.Any())
                    {
                        foreach (var i in app.Student.UserInterests)
                        {
                            <span class="pill pill-green">@i.Interest.Name</span>
                        }
                    }
                </div>

                @if (app.Student.Experiences.Any())
                {
                    <div class="mt-3">
                        <div class="fw-semibold mb-1">Expériences</div>
                        @foreach (var exp in app.Student.Experiences.OrderByDescending(e => e.StartDate))
                        {
                            <div class="small-muted">• <strong>@exp.Title</strong> — @exp.Company</div>
                        }
                    </div>
                }
            </div>
        }
    }

    <a asp-action="Details" asp-route-id="@offerId" class="btn btn-outline-secondary btn-sm">? Retour offre</a>
</div>
