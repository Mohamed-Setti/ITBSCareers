@model ITBSCareers.Models.Carriere.JobOffer
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Publier une offre";
}

<style>
    .offer-wrap { max-width: 900px; margin: 0 auto; padding: 1rem 0 2rem; }
    .offer-card {
        background: #fff;
        border: 1px solid #DCDCE1;
        border-radius: 14px;
        padding: 1rem;
        box-shadow: 0 8px 20px rgba(24,95,165,.06);
    }
    .offer-title {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 2rem;
        letter-spacing: 1px;
        margin-bottom: .2rem;
    }
    .offer-sub { color: #64646E; margin-bottom: .9rem; }
</style>

<div class="container offer-wrap">
    <div class="offer-card">
        <div class="offer-title">Publier une offre</div>
        <div class="offer-sub">Ajoutez une offre de stage ou d'emploi pour les étudiants ITBS.</div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-2">
                <label asp-for="Title" class="form-label">Titre</label>
                <input asp-for="Title" class="form-control" placeholder="Ex: Stage développeur web" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Détails de l'offre..."></textarea>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label asp-for="Type" class="form-label">Type</label>
                    <select asp-for="Type" class="form-select">
                        <option value="Stage">Stage</option>
                        <option value="Emploi">Emploi</option>
                    </select>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Location" class="form-label">Lieu</label>
                    <input asp-for="Location" class="form-control" placeholder="Tunis, Sfax..." />
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary">Publier</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Mes offres</a>
                <a asp-controller="Alumni" asp-action="Index" class="btn btn-light">Retour espace alumni</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
