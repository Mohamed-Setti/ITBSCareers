@model IBSTCareers.Models.DashboardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<style>
    :root {
        --bleu: #185FA5;
        --bleu-light: #E6F1FB;
        --bg: #F5F6F8;
        --white: #fff;
        --border: #DCDCE1;
        --teal: #0F6E56;
        --teal-light: #E1F5EE;
        --amber: #8A5A12;
        --amber-light: #FAEEDA;
        --purple: #3C3489;
        --purple-light: #EEEDFE;
        --text-sec: #64646E;
        --dark: #1E1E28;
    }

    .dash-wrap {
        background: linear-gradient(180deg, #F7F9FC 0%, #F5F6F8 100%);
        border-radius: 16px;
        padding: 1.15rem;
    }

    .dash-topbar, .dash-card, .hot-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: 0 6px 18px rgba(24,95,165,.05);
    }

    .dash-topbar {
        padding: .85rem 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .dash-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        margin-right: .65rem;
    }

    .dash-role-chip {
        font-size: .75rem;
        font-weight: 700;
        padding: .2rem .6rem;
        border-radius: 999px;
        background: var(--bleu-light);
        color: var(--bleu);
        margin-right: .25rem;
    }

    .dash-card, .hot-card {
        padding: .9rem;
        margin-bottom: .75rem;
    }

    .dash-stat {
        font-size: 1.75rem;
        font-weight: 800;
        line-height: 1;
        margin-top: .2rem;
    }

    .dash-title {
        font-size: 1rem;
        font-weight: 800;
        color: var(--dark);
        margin: .6rem 0 .8rem;
    }

    .dash-sub { color: var(--text-sec); font-size: .86rem; }
    .row-stat .dash-card { min-height: 92px; }
    .badge-status { background: var(--teal-light); color: var(--teal); padding: .2rem .55rem; border-radius: 999px; font-size: .72rem; font-weight: 700; }
    .hot-pill {
        display: inline-block;
        padding: .18rem .55rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
        background: #FFF4E6;
        color: #A15C12;
    }
    .hot-score {
        display: inline-block;
        padding: .2rem .55rem;
        border-radius: 999px;
        font-size: .74rem;
        font-weight: 700;
        background: #E1F5EE;
        color: #0F6E56;
    }
</style>

<div class="container mt-3 mb-4">
    @if (ViewBag.Warning != null)
    {
        <div class="alert alert-warning">@ViewBag.Warning</div>
    }

    <div class="dash-wrap">
        <div class="dash-topbar">
            <div class="d-flex align-items-center">
                <span class="dash-avatar" style="background:var(--bleu-light);color:var(--bleu);">
                    @Model.FullName.Substring(0, Math.Min(2, Model.FullName.Length)).ToUpper()
                </span>
                <div>
                    <div class="fw-bold" style="color:var(--dark);">Bonjour, @Model.FullName</div>
                    <div>
                        @foreach (var role in Model.Roles)
                        {
                            <span class="dash-role-chip">@role</span>
                        }
                    </div>
                </div>
            </div>
            <a href="@Url.Action("Profile", "User")" class="btn btn-sm" style="background:var(--teal);color:white;">Profil</a>
        </div>

        @if (Model.IsStudent)
        {
            <div class="dash-title">🔥 Hot opportunities</div>
            @if (Model.HotOpportunities.Any())
            {
                <div class="row g-3 mb-2">
                    @foreach (var offer in Model.HotOpportunities)
                    {
                        <div class="col-md-4">
                            <div class="hot-card h-100">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="hot-pill mb-2">Hot</div>
                                        <h6 class="mb-1">@offer.OfferTitle</h6>
                                        <div class="dash-sub">@offer.Location · @offer.Type</div>
                                    </div>
                                    <span class="hot-score">Match @offer.MatchScore</span>
                                </div>
                                <div class="small text-muted mt-2 mb-2">
                                    @(string.IsNullOrWhiteSpace(offer.MatchSummary) ? "Correspond à votre profil." : offer.MatchSummary)
                                </div>
                                <a asp-controller="JobOffer" asp-action="Details" asp-route-id="@offer.JobId" class="btn btn-sm btn-outline-primary">Voir</a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="dash-card mb-2">
                    <div class="fw-semibold">Aucune suggestion pour le moment</div>
                    <div class="dash-sub">Ajoutez des compétences et centres d'intérêt pour voir apparaître des offres ciblées.</div>
                    <div class="mt-2">
                        <a asp-controller="User" asp-action="Profile" class="btn btn-sm btn-outline-primary">Compléter mon profil</a>
                    </div>
                </div>
            }
        }

        @if (Model.IsVerifiedAlumni)
        {
            <div class="row row-stat g-2">
                <div class="col-md-4"><div class="dash-card"><div class="dash-sub">Offres publiées</div><div class="dash-stat" style="color:var(--teal)">@Model.AlumniPublishedOffersCount</div></div></div>
                <div class="col-md-4"><div class="dash-card"><div class="dash-sub">Candidatures reçues</div><div class="dash-stat" style="color:var(--bleu)">@Model.AlumniApplicationsReceivedCount</div></div></div>
                <div class="col-md-4"><div class="dash-card"><div class="dash-sub">Mentorés actifs</div><div class="dash-stat" style="color:var(--purple)">@Model.AlumniActiveMenteesCount</div></div></div>
            </div>

            <div class="dash-title">Mes offres</div>
            <div class="dash-card d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">Gérer vos offres et candidatures</div>
                    <div class="dash-sub">Publiez une offre, consultez les candidatures et proposez un entretien accepté.</div>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="JobOffer" asp-action="Create" class="btn btn-sm" style="background:var(--teal);color:white;">Nouvelle offre</a>
                    <a asp-controller="JobOffer" asp-action="Index" class="btn btn-sm btn-outline-primary">Mes offres</a>
                </div>
            </div>
        }
        else if (Model.IsStudent)
        {
            <div class="row row-stat g-2">
                <div class="col-md-4"><div class="dash-card"><div class="dash-sub">Candidatures</div><div class="dash-stat" style="color:var(--bleu)">@Model.StudentApplicationsCount</div></div></div>
                <div class="col-md-4"><div class="dash-card"><div class="dash-sub">Statut alumni</div><div class="dash-stat" style="color:var(--teal)">@(Model.AlumniRequestStatus == "Approved" ? 1 : 0)</div></div></div>
                <div class="col-md-4"><div class="dash-card"><div class="dash-sub">Nouvelles offres</div><div class="dash-stat" style="color:var(--amber)">@Model.NewOffersCount</div></div></div>
            </div>

            <div class="dash-title">Vérification alumni</div>
            <div class="dash-card d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">Statut de demande: <span class="badge-status">@(Model.AlumniRequestStatus ?? "Aucune demande")</span></div>
                    <div class="dash-sub">Validation admin obligatoire pour accéder à l'espace alumni.</div>
                </div>
                @if (Model.AlumniRequestStatus == "Pending")
                {
                    <button class="btn btn-sm btn-secondary" disabled>En attente</button>
                }
                else
                {
                    <a asp-controller="AlumniRequest" asp-action="Create" class="btn btn-sm" style="background:var(--teal);color:white;">Demander statut alumni</a>
                }
            </div>
        }

        @if (Model.IsAdmin)
        {
            <div class="dash-title">Admin</div>
            <div class="dash-card d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">Demandes alumni en attente: @Model.PendingAlumniRequestsCount</div>
                    <div class="dash-sub">Validez les demandes et gérez les rôles.</div>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="AlumniRequest" asp-action="Pending" class="btn btn-sm btn-warning">Valider demandes</a>
                    <a asp-controller="Roles" asp-action="Index" class="btn btn-sm btn-outline-dark">Rôles</a>
                </div>
            </div>
        }
    </div>
</div>