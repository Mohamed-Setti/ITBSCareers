@model IBSTCareers.Models.DashboardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<style>
    :root {
        --bleu: #185FA5;
        --bleu-light: #E6F1FB;
        --bg: #F5F6F8;
        --white: #fff;
        --border: #DCDCE1;
        --teal: #0F6E56;
        --teal-light: #E1F5EE;
        --amber: #633806;
        --amber-light: #FAEEDA;
        --purple: #3C3489;
        --purple-light: #EEEDFE;
        --text-sec: #64646E;
        --dark: #1E1E28;
    }

    .dash-wrap {
        background: var(--bg);
        border-radius: 14px;
        padding: 1.25rem;
    }

    .dash-topbar {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: .75rem 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .dash-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        margin-right: .5rem;
    }

    .dash-role-chip {
        font-size: .75rem;
        font-weight: 600;
        padding: .2rem .6rem;
        border-radius: 999px;
        background: var(--bleu-light);
        color: var(--bleu);
        margin-right: .25rem;
    }

    .dash-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: .9rem;
        margin-bottom: .75rem;
    }

    .dash-stat {
        font-size: 1.9rem;
        font-weight: 700;
        line-height: 1;
        margin-top: .2rem;
    }

    .dash-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--dark);
        margin: .5rem 0 .8rem;
    }

    .dash-sub {
        color: var(--text-sec);
        font-size: .85rem;
    }

    .row-stat .dash-card {
        min-height: 92px;
    }

    .badge-status {
        background: var(--teal-light);
        color: var(--teal);
        padding: .2rem .55rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
    }
</style>

<div class="container mt-3 mb-4">
    @if (ViewBag.Warning != null)
    {
        <div class="alert alert-warning">@ViewBag.Warning</div>
    }

    <div class="dash-wrap">
        <div class="dash-topbar">
            <div class="d-flex align-items-center">
                <span class="dash-avatar" style="background:var(--bleu-light);color:var(--bleu);">
                    @Model.FullName.Substring(0, Math.Min(2, Model.FullName.Length)).ToUpper()
                </span>
                <div>
                    <div class="fw-bold" style="color:var(--dark);">Bonjour, @Model.FullName</div>
                    <div>
                        @foreach (var role in Model.Roles)
                        {
                            <span class="dash-role-chip">@role</span>
                        }
                    </div>
                </div>
            </div>
            <a asp-controller="User" asp-action="Profile" class="btn btn-sm" style="background:var(--teal);color:white;">Mon profil</a>
        </div>

        @if (Model.IsVerifiedAlumni)
        {
            <div class="row row-stat g-2">
                <div class="col-md-4"><div class="dash-card"><div class="dash-sub">Offres publiées</div><div class="dash-stat" style="color:var(--teal)">@Model.AlumniPublishedOffersCount</div></div></div>
                <div class="col-md-4"><div class="dash-card"><div class="dash-sub">Candidatures reçues</div><div class="dash-stat" style="color:var(--bleu)">@Model.AlumniApplicationsReceivedCount</div></div></div>
                <div class="col-md-4"><div class="dash-card"><div class="dash-sub">Mentorés actifs</div><div class="dash-stat" style="color:var(--purple)">@Model.AlumniActiveMenteesCount</div></div></div>
            </div>

            <div class="dash-title">Demandes de mentorat en attente</div>
            <div class="dash-card d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">Étudiants intéressés par votre mentorat</div>
                    <div class="dash-sub">Cette section sera alimentée par les vraies demandes.</div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm" style="background:var(--teal);color:white;" disabled>Accepter</button>
                    <button class="btn btn-sm btn-outline-secondary" disabled>Refuser</button>
                </div>
            </div>

            <div class="dash-title">Mes offres publiées</div>
            <div class="dash-card d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">Gérer vos offres et candidatures</div>
                    <div class="dash-sub">Consultez et suivez les candidatures reçues.</div>
                </div>
                <a asp-controller="Alumni" asp-action="Index" class="btn btn-sm" style="background:var(--bleu);color:white;">Espace alumni</a>
            </div>
        }
        else
        {
            <div class="row row-stat g-2">
                <div class="col-md-4"><div class="dash-card"><div class="dash-sub">Candidatures</div><div class="dash-stat" style="color:var(--bleu)">@Model.StudentApplicationsCount</div></div></div>
                <div class="col-md-4"><div class="dash-card"><div class="dash-sub">Mentor actif</div><div class="dash-stat" style="color:var(--teal)">@(Model.AlumniRequestStatus == "Approved" ? 1 : 0)</div></div></div>
                <div class="col-md-4"><div class="dash-card"><div class="dash-sub">Nouvelles offres</div><div class="dash-stat" style="color:var(--amber)">@Model.NewOffersCount</div></div></div>
            </div>

            <div class="dash-title">Offres recommandées pour vous</div>
            <div class="dash-card d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">Basées sur vos compétences et intérêts</div>
                    <div class="dash-sub">Prochaine étape: brancher le moteur de recommandation personnalisé.</div>
                </div>
                <a asp-controller="Experience" asp-action="Create" class="btn btn-sm" style="background:var(--bleu);color:white;">Compléter profil</a>
            </div>

            <div class="dash-title">Vérification alumni</div>
            <div class="dash-card d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">Statut de demande: <span class="badge-status">@(Model.AlumniRequestStatus ?? "Aucune demande")</span></div>
                    <div class="dash-sub">Demandez l'accès alumni, validation par admin obligatoire.</div>
                </div>
                @if (Model.AlumniRequestStatus == "Pending")
                {
                    <button class="btn btn-sm btn-secondary" disabled>En attente d'approbation</button>
                }
                else
                {
                    <a asp-controller="AlumniRequest" asp-action="Create" class="btn btn-sm" style="background:var(--teal);color:white;">Demander statut alumni</a>
                }
            </div>

            <div class="dash-title">Forum & réseau</div>
            <div class="dash-card d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">Activité récente du forum</div>
                    <div class="dash-sub">Participez aux discussions carrière et mentorat.</div>
                </div>
                <a asp-controller="User" asp-action="Profile" class="btn btn-sm btn-outline-secondary">Voir profil</a>
            </div>
        }

        @if (Model.IsAdmin)
        {
            <div class="dash-title">Admin</div>
            <div class="dash-card d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">Demandes alumni en attente: @Model.PendingAlumniRequestsCount</div>
                    <div class="dash-sub">Validez les demandes pour sécuriser l'accès alumni.</div>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="AlumniRequest" asp-action="Pending" class="btn btn-sm btn-warning">Valider demandes</a>
                    <a asp-controller="Roles" asp-action="Index" class="btn btn-sm btn-outline-dark">Rôles</a>
                </div>
            </div>
        }
    </div>
</div>