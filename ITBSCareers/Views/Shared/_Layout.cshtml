<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ITBSCareers</title>

    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ITBSCareers.styles.css" asp-append-version="true" />

    <style>
        :root {
            --bleu: #185FA5;
            --bleu-light: #E6F1FB;
            --teal: #0F6E56;
            --bg: #F5F6F8;
            --white: #fff;
            --border: #DCDCE1;
            --text-sec: #64646E;
            --dark: #1E1E28;
        }

        body {
            background: var(--bg);
            font-family: 'DM Sans', sans-serif;
        }

        .main-nav {
            background: var(--white);
            border-bottom: 1px solid var(--border) !important;
        }

        .brand {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 1.8rem;
            letter-spacing: 2px;
            color: var(--bleu) !important;
            text-decoration: none;
        }

        .brand small {
            font-family: 'DM Sans', sans-serif;
            letter-spacing: .3px;
            font-size: .8rem;
            color: var(--text-sec);
            margin-left: .35rem;
        }

        .main-link {
            color: var(--text-sec) !important;
            font-size: 13px;
            font-weight: 500;
        }

        .main-link:hover { color: var(--bleu) !important; }

        .main-link.active-accent {
            color: var(--teal) !important;
            font-weight: 700;
        }

        .logout-btn {
            border-color: var(--border);
            color: var(--dark);
            background: var(--white);
        }

        .logout-btn:hover {
            background: var(--bleu-light);
            color: var(--bleu);
        }

        .site-footer {
            border-top: 1px solid var(--border);
            background: var(--white);
            padding: 1rem 0;
            margin-top: 1rem;
        }

        .site-footer span {
            font-size: 12px;
            color: var(--text-sec);
        }

        .site-footer a {
            color: var(--bleu);
            text-decoration: none;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm main-nav mb-3">
            <div class="container-fluid">
                @{ var authenticated = User.Identity?.IsAuthenticated ?? false; var isAdmin = authenticated && User.IsInRole("Admin"); var homeAction = authenticated ? (isAdmin ? "Profile" : "Index") : "Login"; var homeController = authenticated ? (isAdmin ? "Admin" : "Dashboard") : "User"; }
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                    ITBS Careers <small>Institut Technologique</small>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-sm-center">
                        <li class="nav-item">
                            <a class="nav-link main-link" href="@Url.Action(homeAction, homeController)">Accueil</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            if (isAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link main-link active-accent" href="@Url.Action("Profile", "Admin")">Profil admin</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link main-link active-accent" href="@Url.Action("Users", "Admin")">Utilisateurs</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link main-link active-accent" href="@Url.Action("Index", "Admin")">Demandes alumni</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link main-link active-accent" asp-controller="Dashboard" asp-action="Index">Tableau de bord</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link main-link active-accent" asp-controller="JobOffer" asp-action="Feed">Offres</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link main-link active-accent" asp-controller="Notification" asp-action="Index">Notifications</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link main-link active-accent" asp-controller="User" asp-action="Profile">Profil</a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link main-link active-accent" asp-controller="User" asp-action="Login">Connexion</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link main-link active-accent" asp-controller="User" asp-action="Create">Inscription</a>
                            </li>
                        }
                    </ul>
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <form asp-controller="User" asp-action="Logout" method="post" class="d-flex">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm logout-btn">Logout</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            <span>
                &copy; 2026 ITBS Careers —
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
