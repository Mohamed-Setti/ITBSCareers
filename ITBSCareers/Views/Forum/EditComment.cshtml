@model ITBSCareers.Models.Forum.ForumCommentUpsertDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Modifier le commentaire";
    var topicId = ViewBag.TopicId as int? ?? 0;
}

<div class="container mt-4" style="max-width:760px;">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h3 class="mb-3">Modifier le commentaire</h3>
            <form asp-action="EditComment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@ViewBag.CommentId" />
                <input type="hidden" name="topicId" value="@topicId" />
                <div class="mb-3">
                    <textarea asp-for="Content" class="form-control" rows="6"></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                    <a asp-action="Details" asp-route-id="@topicId" class="btn btn-outline-secondary">Retour sujet</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
