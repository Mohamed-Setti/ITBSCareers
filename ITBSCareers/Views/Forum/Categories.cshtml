@model IEnumerable<ITBSCareers.Models.Carriere.ForumCategory>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Thématiques";
}

<div class="container mt-4">
    @if (TempData["ForumMessage"] != null)
    {
        <div class="alert alert-info">@TempData["ForumMessage"]</div>
    }
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h3 class="mb-0">Thématiques</h3>
            <div class="text-muted">Catégories configurables par l'administrateur.</div>
        </div>
        <a asp-action="CreateCategory" class="btn btn-primary">Nouvelle thématique</a>
    </div>

    <div class="row g-3">
        @foreach (var category in Model)
        {
            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <h5 class="card-title mb-1">@category.Name</h5>
                                <div class="text-muted small">@(category.Description ?? "Aucune description")</div>
                            </div>
                            <span class="badge @(category.IsActive ? "bg-success" : "bg-secondary")">@(category.IsActive ? "Active" : "Inactive")</span>
                        </div>
                        <div class="mt-3 d-flex gap-2 flex-wrap">
                            <a asp-action="EditCategory" asp-route-id="@category.ForumCategoryId" class="btn btn-sm btn-outline-primary">Modifier</a>
                            <form asp-action="DeleteCategory" method="post" onsubmit="return confirm('Supprimer cette thématique ?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@category.ForumCategoryId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
