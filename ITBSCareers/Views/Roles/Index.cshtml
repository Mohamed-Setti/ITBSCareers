@model IEnumerable<ITBSCareers.Models.Carriere.Role>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Roles";
}

<div class="container mt-4">
    <h2>Roles</h2>

    <p>
        <a asp-action="Create" class="btn btn-primary">Create new role</a>
    </p>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.RoleId</td>
                <td>@role.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@role.RoleId" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@role.RoleId" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@role.RoleId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
